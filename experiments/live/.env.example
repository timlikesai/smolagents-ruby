# Live Experiments Infrastructure Configuration
#
# Copy this file to .env and fill in your endpoint URLs.
# These endpoints are machine-specific and should not be committed.
#
# Example values shown - replace with your actual infrastructure.

# Primary endpoint (fast GPU server running llama.cpp)
LLAMA_CPP_ULTRA_URL=https://your-llama-cpp-server.local/v1

# Secondary endpoint (LM Studio on macbook)
MACBOOK_PRO_M4_URL=http://your-macbook.local:1234/v1

# Tertiary endpoint (LM Studio on mac studio)
MAC_STUDIO_URL=http://your-mac-studio.local:1234/v1

# Model IDs (as reported by /v1/models endpoint)
# Fast model for quick tasks
FAST_MODEL_ID=GLM-4.7-Flash-Q4_1

# Large reasoning model
REASONING_MODEL_ID=NVIDIA-Nemotron-3-Nano-30B-A3B-Q4_1

# Coding specialist
CODER_MODEL_ID=Devstral-Small-2-24B-Instruct-2512-Q4_1

# Math specialist
MATH_MODEL_ID=Qwen3-4B-math.Q8_0

# Tiny utility model
UTILITY_MODEL_ID=LFM2.5-1.2B-Instruct-Q8_0

# Fallback model (on secondary endpoint)
FALLBACK_MODEL_ID=glm-4.7-flash-mlx@8bit
